/**
 * @file ThreatForge local VS Code task catalog.
 *
 * @implementsRequirement MR-0002ADR-0005REQ-0001
 * @implementsRequirement MR-0002ADR-0005REQ-0001GOV-0001
 * @implementsRequirement MR-0002ADR-0005REQ-0002
 * @implementsRequirement MR-0002ADR-0005REQ-0002GOV-0001
 * @implementsRequirement MR-0002ADR-0001REQ-0001
 * @implementsRequirement MR-0002ADR-0001REQ-0001GOV-0001
 * @implementsRequirement MR-0002ADR-0003REQ-0001
 * @implementsRequirement MR-0002ADR-0003REQ-0001GOV-0001
 * @implementsRequirement MR-0002ADR-0003REQ-0002
 * @implementsRequirement MR-0002ADR-0003REQ-0002GOV-0001
 * @derivedFromDecision MR-0002/ADR-0005
 * @derivedFromDecision MR-0002/ADR-0001
 * @derivedFromDecision MR-0002/ADR-0003
 * @macroRequirement MR-0002
 * @implementationStatus implemented
 */
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ThreatForge: repo-check",
      "type": "process",
      "command": "node",
      "args": [
        "tools/repo-check.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: check implementation trace",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/check-implementation-trace-registry.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: check documentation field values",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/check-documentation-field-values.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: check governed body headers",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/check-governed-body-headers.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: preview requirement authoring",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/run-requirement-authoring.mjs",
        "--preview"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "ThreatForge: create requirement authoring",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/run-requirement-authoring.mjs",
        "--create"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "ThreatForge: plan implementation artifact dry-run",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/plan-governed-implementation.mjs",
        "--requirement",
        "${input:threatForgeImplementationRequirementId}",
        "--artifact-type",
        "${input:threatForgeImplementationArtifactType}",
        "--title",
        "${input:threatForgeImplementationArtifactTitle}",
        "--path",
        "${input:threatForgeImplementationArtifactPath}",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: create implementation scaffold",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/create-governed-implementation-scaffold.mjs",
        "--requirement",
        "${input:threatForgeImplementationRequirementId}",
        "--artifact-type",
        "${input:threatForgeImplementationArtifactType}",
        "--title",
        "${input:threatForgeImplementationArtifactTitle}",
        "--path",
        "${input:threatForgeImplementationArtifactPath}",
        "--confirm",
        "${input:threatForgeImplementationCreateConfirmation}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: promote implementation scaffold",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/promote-governed-implementation-scaffold.mjs",
        "--artifact-id",
        "${input:threatForgeImplementationArtifactId}",
        "--confirm",
        "${input:threatForgeImplementationPromotionConfirmation}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: create handoff archive dry-run",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/create-handoff-archive.mjs",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "threatForgeImplementationRequirementId",
      "type": "promptString",
      "description": "ID del requisito governato da implementare",
      "default": "MR-0002ADR-0001REQ-0001"
    },
    {
      "id": "threatForgeImplementationArtifactType",
      "type": "pickString",
      "description": "Tipo di artefatto implementativo",
      "options": [
        "tool",
        "source-module",
        "test",
        "fixture"
      ],
      "default": "tool"
    },
    {
      "id": "threatForgeImplementationArtifactTitle",
      "type": "promptString",
      "description": "Titolo dell'artefatto implementativo"
    },
    {
      "id": "threatForgeImplementationArtifactPath",
      "type": "promptString",
      "description": "Path relativo proposto per l'artefatto",
      "default": "tools/MR-0002/example.mjs"
    },
    {
      "id": "threatForgeImplementationCreateConfirmation",
      "type": "pickString",
      "description": "Conferma la creazione dello scaffold",
      "options": [
        "cancel",
        "create"
      ],
      "default": "cancel"
    },
    {
      "id": "threatForgeImplementationArtifactId",
      "type": "promptString",
      "description": "ID dell'artefatto scaffolded da promuovere",
      "default": "MR-0002ADR-0003REQ-0001GOV-0002IMPL-0003"
    },
    {
      "id": "threatForgeImplementationPromotionConfirmation",
      "type": "pickString",
      "description": "Conferma la promozione dello scaffold verificato",
      "options": [
        "cancel",
        "promote"
      ],
      "default": "cancel"
    }
  ]
}
