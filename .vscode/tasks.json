/**
 * @file ThreatForge local VS Code task catalog.
 *
 * @implementsRequirement MR-0001ADR-0007REQ-0001
 * @implementsRequirement MR-0001ADR-0007REQ-0001GOV-0001
 * @implementsRequirement MR-0002ADR-0001REQ-0001
 * @implementsRequirement MR-0002ADR-0001REQ-0001GOV-0001
 * @implementsRequirement MR-0002ADR-0003REQ-0001
 * @implementsRequirement MR-0002ADR-0003REQ-0001GOV-0001
 * @derivedFromDecision MR-0001/ADR-0007
 * @derivedFromDecision MR-0002/ADR-0001
 * @derivedFromDecision MR-0002/ADR-0003
 * @macroRequirement MR-0001
 * @macroRequirement MR-0002
 */
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ThreatForge: repo-check",
      "type": "process",
      "command": "node",
      "args": [
        "tools/repo-check.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: check implementation trace",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/check-implementation-trace-registry.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: check documentation field values",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/check-documentation-field-values.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: check governed body headers",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/check-governed-body-headers.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: create functional requirement dry-run",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/create-governed-document.mjs",
        "--kind",
        "functional-requirement",
        "--mr",
        "${input:threatForgeMrId}",
        "--adr",
        "${input:threatForgeAdrId}",
        "--title",
        "${input:threatForgeFunctionalRequirementTitle}",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: create governance requirement dry-run",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/create-governed-document.mjs",
        "--kind",
        "governance-requirement",
        "--mr",
        "${input:threatForgeMrId}",
        "--parent",
        "${input:threatForgeParentRequirementId}",
        "--title",
        "${input:threatForgeGovernanceRequirementTitle}",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: plan implementation artifact dry-run",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/plan-governed-implementation.mjs",
        "--requirement",
        "${input:threatForgeImplementationRequirementId}",
        "--artifact-type",
        "${input:threatForgeImplementationArtifactType}",
        "--title",
        "${input:threatForgeImplementationArtifactTitle}",
        "--path",
        "${input:threatForgeImplementationArtifactPath}",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: create implementation scaffold",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0002/create-governed-implementation-scaffold.mjs",
        "--requirement",
        "${input:threatForgeImplementationRequirementId}",
        "--artifact-type",
        "${input:threatForgeImplementationArtifactType}",
        "--title",
        "${input:threatForgeImplementationArtifactTitle}",
        "--path",
        "${input:threatForgeImplementationArtifactPath}",
        "--confirm",
        "${input:threatForgeImplementationCreateConfirmation}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "ThreatForge: create handoff archive dry-run",
      "type": "process",
      "command": "node",
      "args": [
        "tools/MR-0001/create-handoff-archive.mjs",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "threatForgeMrId",
      "type": "promptString",
      "description": "Macro-requirement ID",
      "default": "MR-0001"
    },
    {
      "id": "threatForgeAdrId",
      "type": "promptString",
      "description": "ADR ID",
      "default": "ADR-0007"
    },
    {
      "id": "threatForgeFunctionalRequirementTitle",
      "type": "promptString",
      "description": "Titolo del requisito funzionale"
    },
    {
      "id": "threatForgeParentRequirementId",
      "type": "promptString",
      "description": "ID del requisito funzionale padre",
      "default": "MR-0001ADR-0007REQ-0001"
    },
    {
      "id": "threatForgeGovernanceRequirementTitle",
      "type": "promptString",
      "description": "Titolo del requisito di governance"
    },
    {
      "id": "threatForgeImplementationRequirementId",
      "type": "promptString",
      "description": "ID del requisito governato da implementare",
      "default": "MR-0002ADR-0001REQ-0001"
    },
    {
      "id": "threatForgeImplementationArtifactType",
      "type": "pickString",
      "description": "Tipo di artefatto implementativo",
      "options": [
        "tool",
        "source-module",
        "test",
        "fixture"
      ],
      "default": "tool"
    },
    {
      "id": "threatForgeImplementationArtifactTitle",
      "type": "promptString",
      "description": "Titolo dell'artefatto implementativo"
    },
    {
      "id": "threatForgeImplementationArtifactPath",
      "type": "promptString",
      "description": "Path relativo proposto per l'artefatto",
      "default": "tools/MR-0002/example.mjs"
    },
    {
      "id": "threatForgeImplementationCreateConfirmation",
      "type": "pickString",
      "description": "Conferma la creazione dello scaffold",
      "options": [
        "cancel",
        "create"
      ],
      "default": "cancel"
    }
  ]
}
